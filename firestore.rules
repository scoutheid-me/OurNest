rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHousehold(data) {
      return data.keys().hasAll(['ownerId', 'appDataJson'])
        && data.keys().size() == 2
        && data.ownerId == request.auth.uid
        && data.appDataJson is string
        && data.appDataJson.size() <= 800000;
    }

    match /households/{householdId} {
      allow get: if isSignedIn() && isValidId(householdId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() 
                    && isValidId(householdId) 
                    && isValidHousehold(incoming());

      allow update: if isSignedIn() 
                    && isValidId(householdId) 
                    && existing().ownerId == request.auth.uid
                    && isValidHousehold(incoming())
                    && incoming().ownerId == existing().ownerId;
                    
      allow delete: if isSignedIn() && isValidId(householdId) && existing().ownerId == request.auth.uid;
    }
  }
}
